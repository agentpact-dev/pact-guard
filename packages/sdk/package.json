{
  "name": "@agentpact/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AgentPact - financial guardrails for AI agents on Robinhood Chain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "homepage": "https://github.com/agentpact-dev/pact-guard/tree/main/packages/sdk",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": ["agentpact", "ai-agents", "mcp", "robinhood-chain", "financial-guardrails"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentpact-dev/pact-guard.git",
    "directory": "packages/sdk"
  }
}
